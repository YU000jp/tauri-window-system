{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "tauri-plugin-window-system-api": ["../../packages/tauri-plugin-window-system-api/index.ts"],
      "tauri-window-ui": ["../../packages/tauri-window-ui/index.ts"]
    },
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "vite.config.ts"]
}
